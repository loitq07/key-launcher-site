{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/vi/blog",
      "destination": "/blog/vi"
    },
    {
      "source": "/vi/blog/:path*",
      "destination": "/blog/vi/:path*"
    },
    {
      "source": "/help",
      "destination": "https://key-launcher-help-xyz.vercel.app/help"
    },
    {
      "source": "/help/:path*",
      "destination": "https://key-launcher-help-xyz.vercel.app/help/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!\\.well-known(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "keylauncher.app"
        }
      ],
      "destination": "https://www.keylauncher.app/:path",
      "permanent": true
    },
    {
      "source": "/api/pricing.js",
      "destination": "/api/pricing",
      "permanent": false
    },
    {
      "source": "/guide",
      "destination": "https://www.keylauncher.app/help",
      "permanent": true
    },
    {
      "source": "/guide/:path*",
      "destination": "https://www.keylauncher.app/help/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
